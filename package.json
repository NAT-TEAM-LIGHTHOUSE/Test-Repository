{
  "name": "website",
  "version": "0.0.0",

  "scripts": {
    "ng": "ng",

    "start": "ng serve",

    "start:prod": "ng serve --configuration production",
    "start:preprod": "ng serve --configuration preprod",
    "start:uat": "ng serve --configuration uat",
    "start:dev": "ng serve --configuration dev",

    "build:prod": "ng build --configuration production",
    "build:preprod": "ng build --configuration preprod",
    "build:uat": "ng build --configuration uat",
    "build:dev": "ng build --configuration dev",

    "watch": "ng build --watch --configuration development",

    "test": "ng test",

    "serve:ssr:website": "node dist/website/server/server.mjs"
  },


  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.12",
    "@fancyapps/ui": "^6.1.14",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@intl-tel-input/angular": "^29.2.3",
    "bootstrap": "^5.3.8",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "i": "^0.3.7",
    "ng-recaptcha": "^13.2.1",
    "npm": "^11.19.1",
    "rxjs": "~7.8.0",
    "swiper": "^14.2.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.12",
    "@angular/cli": "^20.3.12",
    "@angular/compiler-cli": "^20.3.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.2"
  }
}
